{
  "expo": {
    "name": "دليل السعودية",
    "slug": "saudi-guide",
    "scheme": "saudiguide",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0EFEF",
    "ios": {
      "bundleIdentifier": "com.saudiguide",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك عشان نعرض لك الأماكن القريبة منك."
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.saudi-guide.com",
        "applinks:saudi-guide.com"
      ]
    },
    "android": {
      "package": "carizmaapps.saudiguide",
      "adaptiveIcon": {
        "backgroundColor": "#604C87",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/place"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/article"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/city"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/question"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/coupon"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/season"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-white.png",
          "imageWidth": 220,
          "backgroundColor": "#604C87"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج دليل السعودية الوصول لصورك عشان تشارك صور الأماكن في المجتمع.",
          "cameraPermission": "يحتاج دليل السعودية الكاميرا عشان تصوّر المكان وتشاركه في المجتمع.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "owner": "carizma-tech"
  }
}