{
  "expo": {
    "name": "دليل السعودية",
    "slug": "saudi-guide",
    "scheme": "saudiguide",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0EFEF",
    "ios": {
      "bundleIdentifier": "com.saudiguide",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك عشان نعرض لك الأماكن القريبة منك.",
        "NSMicrophoneUsageDescription": "نستخدم المايكروفون عشان تبحث بصوتك في الدليل، ولتسجيل الصوت مع فيديو المكان اللي تشاركه.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "نستخدم موقعك عشان نعرض لك الأماكن القريبة منك.",
        "NSLocationAlwaysUsageDescription": "نستخدم موقعك عشان نعرض لك الأماكن القريبة منك.",
        "NSFaceIDUsageDescription": "نستخدم Face ID لحماية بيانات دخولك المحفوظة في الجهاز.",
        "NSMotionUsageDescription": "قد يستخدم التطبيق مستشعرات الحركة مع موقعك لعرض الأماكن القريبة بدقة أكبر.",
        "CFBundleDevelopmentRegion": "ar",
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.saudi-guide.com",
        "applinks:saudi-guide.com"
      ],
      "appleTeamId": "V8N7C973S7",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.saudiguide"
        ]
      }
    },
    "android": {
      "package": "carizmaapps.saudiguide",
      "adaptiveIcon": {
        "backgroundColor": "#604C87",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/place"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/article"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/city"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/question"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/coupon"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/season"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/plan"
            },
            {
              "scheme": "https",
              "host": "www.saudi-guide.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-white.png",
          "imageWidth": 220,
          "backgroundColor": "#604C87"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج دليل السعودية الوصول لصورك عشان تشارك صور الأماكن في المجتمع.",
          "cameraPermission": "يحتاج دليل السعودية الكاميرا عشان تصوّر المكان وتشاركه في المجتمع.",
          "microphonePermission": "نستخدم المايكروفون عشان تبحث بصوتك في الدليل، ولتسجيل الصوت مع فيديو المكان اللي تشاركه."
        }
      ],
      "expo-iap",
      [
        "expo-notifications",
        {
          "color": "#604C87"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-5413358932647152~6606911075",
          "androidAppId": "ca-app-pub-5413358932647152~3928776847",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "نستخدم هذا لعرض إعلانات تناسب اهتماماتك. تقدر ترفض وتظهر لك إعلانات عامة."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "نستخدم المايكروفون عشان تبحث بصوتك في الدليل، ولتسجيل الصوت مع فيديو المكان اللي تشاركه.",
          "speechRecognitionPermission": "نحوّل كلامك لنص عشان نبحث لك عن الأماكن.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0b12b8b0-edf6-42bb-8bfd-31c7b0b72ae7"
      }
    },
    "owner": "carizma-tech",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
